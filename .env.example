# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar OAuth (Google Cloud Console → APIs & Serviços → Credenciais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://o-teu-dominio.vercel.app/api/google/callback

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Massa Mãe <onboarding@resend.dev>"

# Email para onde vão os lembretes diários
REMINDER_EMAIL=o-teu-email@exemplo.com

# Secret aleatório — protege o endpoint do cron. A Vercel envia-o
# automaticamente como Authorization: Bearer <valor> quando defines
# esta env var e usas vercel.json com "crons".
CRON_SECRET=escolhe-uma-string-aleatoria-longa
